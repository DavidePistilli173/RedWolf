{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "redwolf_debug",
      "displayName": "redwolf Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RW_BUILD_PROFILER": "OFF",
        "RW_BUILD_TESTS": "ON",
        "RW_ENABLE_LOGGING": "ON",
        "RW_ENABLE_PROFILING": "OFF",
        "RW_ENABLE_VULKAN_DEBUG": "ON"
      }
    },
    {
      "name": "redwolf_release_with_profiler",
      "displayName": "redwolf Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RW_BUILD_PROFILER": "ON",
        "RW_BUILD_TESTS": "ON",
        "RW_ENABLE_LOGGING": "ON",
        "RW_ENABLE_PROFILING": "ON",
        "RW_ENABLE_VULKAN_DEBUG": "ON"
      }
    },
    {
      "name": "redwolf_release",
      "displayName": "redwolf Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RW_BUILD_PROFILER": "OFF",
        "RW_BUILD_TESTS": "ON",
        "RW_ENABLE_LOGGING": "ON",
        "RW_ENABLE_PROFILING": "ON",
        "RW_ENABLE_VULKAN_DEBUG": "ON"
      }
    },
    {
      "name": "redwolf_release_performance",
      "displayName": "redwolf Release Performance",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RW_BUILD_PROFILER": "OFF",
        "RW_BUILD_TESTS": "ON",
        "RW_ENABLE_LOGGING": "OFF",
        "RW_ENABLE_PROFILING": "OFF",
        "RW_ENABLE_VULKAN_DEBUG": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "redwolf_debug",
      "configurePreset": "redwolf_debug"
    },
    {
      "name": "redwolf_release",
      "configurePreset": "redwolf_release"
    },
    {
      "name": "redwolf_release_performance",
      "configurePreset": "redwolf_release_performance"
    }
  ]
}